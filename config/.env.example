# Optional provider environment variables. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# LiteLLM gateway (must be started separately: litellm --config
# config/litellm_config.yaml --port 4000). health_report() defaults to
# http://localhost:4000 if LITELLM_BASE_URL is unset.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=

